---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../lib/paths';
import { getCollection } from 'astro:content';
import '../styles/home-v2.css';
const notes = (await getCollection('notes')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
---
<BaseLayout title="首页" active="home" description="Winter Simon 的个人主页：凝聚态物理、高温超导兴趣、学习笔记与独立软件项目。">
  <div class="new-home">
    <section class="new-hero" id="home">
      <div class="hero-light hero-light-a"></div><div class="hero-light hero-light-b"></div>
      <div class="new-wrap new-hero-grid">
        <div class="new-hero-copy">
          <div class="new-kicker"><span class="new-spark"></span> PERSONAL PORTFOLIO <i></i> 2026</div>
          <p class="new-intro">你好，我是</p>
          <h1>司马文涛<span>.</span></h1>
          <h2>探索物理世界，<br />也创造自己的工具。</h2>
          <p class="new-deck">物理学本科生 · 独立软件开发者</p>
          <p class="new-summary">关注凝聚态物理与高温超导。热衷于把抽象的理论、日常的思考，转化为能够被理解、操作和持续改进的作品。</p>
          <div class="new-hero-actions">
            <a class="new-primary" href="#projects">查看项目 <span>↗</span></a>
            <a class="new-plain" href="#about">了解更多 <span>↓</span></a>
          </div>
        </div>
        <div class="new-orbit-field" aria-hidden="true">
          <span class="new-diagram-title">FIG. 01 / STRUCTURE & SYMMETRY</span>
          <svg viewBox="0 0 560 520" fill="none" role="presentation">
            <defs>
              <linearGradient id="orbitalLine" x1="50" x2="490" y1="30" y2="480" gradientUnits="userSpaceOnUse"><stop stop-color="#9CB0FF" stop-opacity="0"/><stop offset=".45" stop-color="#C4D9FF" stop-opacity=".8"/><stop offset="1" stop-color="#9CB0FF" stop-opacity=".08"/></linearGradient>
              <radialGradient id="nucleus"><stop stop-color="#F6FCFF"/><stop offset=".6" stop-color="#B8CFF9"/><stop offset="1" stop-color="#7285D9"/></radialGradient>
            </defs>
            <circle cx="280" cy="260" r="196" stroke="#9FB7EE" stroke-opacity=".14" stroke-dasharray="3 10"/>
            <circle cx="280" cy="260" r="238" stroke="#9FB7EE" stroke-opacity=".08"/>
            <ellipse cx="280" cy="260" rx="223" ry="102" transform="rotate(-38 280 260)" stroke="url(#orbitalLine)" stroke-width="1.3"/>
            <ellipse cx="280" cy="260" rx="223" ry="102" transform="rotate(50 280 260)" stroke="url(#orbitalLine)" stroke-width="1.3"/>
            <ellipse cx="280" cy="260" rx="187" ry="105" transform="rotate(108 280 260)" stroke="url(#orbitalLine)"/>
            <circle cx="280" cy="260" r="78" fill="#C6D8FF" fill-opacity=".025"/><circle cx="280" cy="260" r="43" fill="#C6D8FF" fill-opacity=".055"/>
            <circle cx="280" cy="260" r="13" fill="url(#nucleus)"/>
            <circle cx="439" cy="104" r="5" fill="#F2F7FF"/><circle cx="439" cy="104" r="12" stroke="#D5E7FF" stroke-opacity=".4"/>
            <circle cx="108" cy="345" r="4" fill="#D5E7FF"/><circle cx="382" cy="418" r="3.5" fill="#D5E7FF"/>
            <path d="M70 76h22M81 65v22M464 434h18m-9-9v18" stroke="#BDD0F7" stroke-opacity=".65"/>
          </svg>
          <span class="new-diagram-footer">AN EXPLORATION OF THE PHYSICAL WORLD</span>
        </div>
      </div>
      <div class="new-wrap new-hero-topics">
        <div><span>01 / FIELD</span><strong>凝聚态物理</strong><small>Condensed Matter</small></div>
        <div><span>02 / INTEREST</span><strong>高温超导</strong><small>Superconductivity</small></div>
        <div><span>03 / BUILDING</span><strong>软件与知识工具</strong><small>Useful Things</small></div>
      </div>
    </section>

    <section class="new-section new-about" id="about">
      <div class="new-wrap new-about-grid">
        <div class="new-overline"><span>01</span> ABOUT ME <p>Beyond the equations.</p></div>
        <div class="new-about-copy"><h2>不止于理解，<br /><em>还想亲手创造。</em></h2>
          <p class="new-lead">我是一名物理学本科生，正在系统学习量子力学，并向凝聚态物理、尤其高温超导实验方向探索。</p>
          <p>与此同时，我对软件设计与知识管理保持兴趣。开发 Smart WorkSpace，是将自己的学习与工作需求转化成实际产品的一次尝试。</p>
          <a class="new-inline-link" href={href('/about/')}>阅读完整介绍 <span>↗</span></a>
        </div>
      </div>
    </section>

    <section class="new-section new-journey" id="journey">
      <div class="new-wrap"><div class="new-section-heading"><div><div class="new-overline"><span>02</span> MY JOURNEY</div><h2>学术方向与探索</h2></div><p>研究方向正在形成，<br />每一步都值得认真记录。</p></div>
        <div class="new-journey-grid">
          <article class="new-journey-card"><span>01 / EDUCATION</span><h3>物理学 · 本科</h3><p class="new-card-sub">Physics Undergraduate</p><p>从经典力学到量子理论，持续建立物理基础，并训练数学推导和问题求解能力。</p><small>正在学习</small></article>
          <article class="new-journey-card new-journey-dark"><span>02 / RESEARCH INTEREST</span><h3>凝聚态与高温超导</h3><p class="new-card-sub">Condensed Matter & Superconductivity</p><p>关注实验凝聚态和材料中的集体现象，逐步从单粒子问题走向量子多体理论。</p><small>研究兴趣 · 尚非研究成果</small></article>
        </div>
      </div>
    </section>

    <section class="new-section new-work" id="projects">
      <div class="new-wrap"><div class="new-section-heading"><div><div class="new-overline"><span>03</span> SELECTED WORK</div><h2>项目与作品<span>.</span></h2></div><a class="new-inline-link" href={href('/projects/')}>全部项目 ↗</a></div>
      <div class="new-work-grid">
        <a class="new-project" href={href('/projects/smart-workspace/')}>
          <div class="new-project-art new-project-app">
            <div class="new-app-window"><div class="new-app-rail"><b>✳</b><i></i><i></i><i></i></div><div class="new-app-screen"><div class="new-app-top"><span>今日 · 执行</span><span>Smart WorkSpace</span></div><strong>今天想完成什么？</strong><div class="new-app-cols"><div><small>主线</small><i></i><i></i><i></i></div><div><small>专注</small><div class="new-focus-ring">25<sup>MIN</sup></div></div></div></div></div>
            <small class="new-art-note">UI CONCEPT / 001 · 界面示意</small>
          </div>
          <div class="new-project-info"><div><small>INDEPENDENT PROJECT · 持续开发</small><h3>Smart WorkSpace</h3><p>面向真实工作流的 Obsidian 插件，连接思考、行动、项目与复盘。</p></div><span>↗</span></div>
        </a>
        <a class="new-project" href={href('/projects/physics-lab/')}>
          <div class="new-project-art new-project-physics"><div class="new-model" aria-hidden="true"><span class="new-model-a"></span><span class="new-model-b"></span><span class="new-model-c"></span><span class="new-model-center"></span></div><small class="new-art-note">PHYSICS / 002 · 概念构想</small></div>
          <div class="new-project-info"><div><small>CONCEPT / EXPLORATION · 规划中</small><h3>Interactive Physics Lab</h3><p>用交互实验呈现抽象的物理概念，从对称性到量子态的可视化。</p></div><span>↗</span></div>
        </a>
      </div></div>
    </section>

    <section class="new-section new-writing" id="writing"><div class="new-wrap"><div class="new-section-heading"><div><div class="new-overline"><span>04</span> NOTES & IDEAS</div><h2>思考的轨迹<span>.</span></h2></div><a class="new-inline-link" href={href('/notes/')}>进入知识花园 ↗</a></div>
      <p class="new-writing-intro">笔记不是完成的结论，而是持续生长的理解。这里收集值得反复推敲的物理问题。</p>
      <div class="new-writing-list">{notes.map((note,i) => <a class="new-writing-row" href={href('/notes/' + note.id + '/')}><span>0{i+1}</span><div><small>{note.data.topic} · {note.data.stage}</small><h3>{note.data.title}</h3><p>{note.data.summary}</p></div><b>↗</b></a>)}</div>
    </div></section>

    <section class="new-contact" id="contact"><div class="new-wrap new-contact-grid"><div><div class="new-overline"><span>05</span> GET IN TOUCH</div><h2>保持好奇。<br /><em>继续探索。</em></h2><p>欢迎交流物理问题、软件开发，以及任何值得认真思考的想法。</p></div><a href="https://github.com/Winter-Simon" rel="noopener noreferrer" target="_blank">在 GitHub 找到我 <span>↗</span></a></div></section>
  </div>
</BaseLayout>
