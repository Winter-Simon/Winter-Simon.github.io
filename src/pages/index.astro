---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteRow from '../components/NoteRow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { href } from '../lib/paths';
import { getCollection } from 'astro:content';
const notes = (await getCollection('notes')).sort((a,b) => a.data.order - b.data.order).slice(0,3);
---
<BaseLayout title="首页" active="home">
  <section class="shell hero">
    <div class="hero-left">
      <div class="eyebrow"><span class="status-pip"></span> A PERSONAL RESEARCH SPACE <span class="line"></span> EST. 2026</div>
      <h1>理解世界<span class="h1-punctuation">，</span><br />构建工具<span class="h1-punctuation">。</span></h1>
      <p class="hero-description">这里收集我对物理世界的理解、不断生长的学习笔记，以及为更好地思考与工作而创造的软件。</p>
      <div class="hero-actions"><a class="button-primary" href={href('/notes/')}>进入知识花园 <span>↗</span></a><a class="text-link" href={href('/projects/')}>浏览作品 <span>↗</span></a></div>
    </div>
    <aside class="hero-aside" aria-label="正在探索">
      <div class="aside-top"><span>FIELD NOTES / 001</span><span class="asterisk">✳</span></div>
      <div class="orbit-illustration" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="orbit-center"></span><span class="orbit-planet"></span></div>
      <div class="aside-bottom"><span class="smallcaps">CURRENTLY EXPLORING</span><h2>从量子力学<br />走向凝聚态物理</h2><p>Quantum mechanics, symmetry & condensed matter.</p></div>
    </aside>
  </section>

  <section class="shell section-block">
    <div class="section-head"><div><span class="section-index">01 / WORK</span><h2>创造与实验<span> / Selected Work</span></h2></div><a class="text-link" href={href('/projects/')}>全部项目 ↗</a></div>
    <div class="project-grid">{projects.map(project => <ProjectCard project={project} />)}</div>
  </section>

  <section class="shell section-block notes-section">
    <div class="section-head"><div><span class="section-index">02 / NOTES</span><h2>近期思考<span> / From the Garden</span></h2></div><a class="text-link" href={href('/notes/')}>全部笔记 ↗</a></div>
    <div class="notes-list">{notes.map(note => <NoteRow id={note.id} title={note.data.title} summary={note.data.summary} topic={note.data.topic} stage={note.data.stage} date={note.data.updated} />)}</div>
  </section>

  <section class="shell site-manifesto"><span>AN OPEN-ENDED PRACTICE</span><p>学习不是知识的堆积。<br />它是不断修正模型、形成判断，<br />并尝试创造新事物的过程。</p><a href={href('/about/')}>关于这个网站 <span aria-hidden="true">↗</span></a></section>
</BaseLayout>
